            statusLabel.Text = "Status: Link copied to clipboard!"
        end
    )

    -- Discord Button
    local discordButton = CreateButton(
        contentContainer, 
        "Join Discord", 
        UDim2.new(0, 0, 0, 130), 
        UDim2.new(1, 0, 0, 30),
        function()
            -- Open Discord invite
            pcall(function()
                setclipboard("https://discord.gg/phantomhub")
            end)

            ShowNotification(self.GUI, "Discord invite copied to clipboard!", nil)
        end
    )

    -- Check for saved key
    local savedKey = nil
    pcall(function()
        if Player:FindFirstChild("PhantomHubKey") then
            savedKey = Player.PhantomHubKey.Value
        end
    end)

    if savedKey and savedKey ~= "" then
        keyInputBox.Text = savedKey
        statusLabel.Text = "Status: Key found! Click Submit to verify."
        statusLabel.TextColor3 = SECONDARY_TEXT_COLOR
    end

    -- Animate opening
    AnimateOpen(self.KeyWindow, KEY_WINDOW_SIZE)

    return self
end

-- Load Main UI
function KeySystem:LoadMainUI()
    -- Destroy key system GUI
    if self.GUI then
        self.GUI:Destroy()
    end

    -- Store whether the current user is an admin
    local isAdmin = IsAuthorizedAdmin()

    -- Create a flag to pass to the main UI
    local adminFlag = Instance.new("BoolValue")
    adminFlag.Name = "IsAdmin"
    adminFlag.Value = isAdmin
    adminFlag.Parent = Player

    -- Show notification about admin status
    if isAdmin then
        -- Create a notification in the game to inform the user they have admin access
        local adminNotification = Instance.new("ScreenGui")
        adminNotification.Name = "AdminNotification"
        adminNotification.Parent = CoreGui

        local notificationFrame = CreateInstance("Frame", {
            Name = "NotificationFrame",
            Parent = adminNotification,
            BackgroundColor3 = Color3.fromRGB(40, 40, 40),
            BorderSizePixel = 0,
            Position = UDim2.new(0.5, -150, 0, -50),
            Size = UDim2.new(0, 300, 0, 40),
            ZIndex = 10
        })

        local notificationCorner = CreateInstance("UICorner", {
            CornerRadius = UDim.new(0, 6),
            Parent = notificationFrame
        })

        local notificationText = CreateInstance("TextLabel", {
            Name = "NotificationText",
            Parent = notificationFrame,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(1, -20, 1, 0),
            Font = FONT,
            Text = "Admin access granted. You can access the admin panel and key generator.",
            TextColor3 = TEXT_COLOR,
            TextSize = 12,
            TextWrapped = true,
            ZIndex = 11
        })

        -- Animate the notification
        CreateTween(notificationFrame, {Position = UDim2.new(0.5, -150, 0, 20)}):Play()

        -- Remove notification after delay
        delay(5, function()
            CreateTween(notificationFrame, {Position = UDim2.new(0.5, -150, 0, -50)}):Play()
            delay(0.5, function()
                adminNotification:Destroy()
            end)
        end)
    end

    -- Create the main UI with baseplate functionality
    -- Show the baseplate color selection GUI
    local baseplateGUI = createColorSelectionGUI()

    -- Load the main UI script if available
    if MainScript then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/ta679/g/refs/heads/main/Testuiiiii"))()
    else
        -- If no main script is provided, we can use a default one or just rely on the baseplate functionality
        ShowNotification(baseplateGUI, "Phantom Hub Premium - Infinite Baseplate mode activated!", SUCCESS_COLOR)
    end
end

